							"raw": "{{baseUrl}}/api/mongodb/bookings/user/{{userId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "mongodb", "bookings", "user", "{{userId}}"]
						}
					}
				}
			]
		},
