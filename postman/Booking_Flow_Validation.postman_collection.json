									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"})"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/mongodb/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "mongodb", "bookings"]
						}
					}
				},
				{
					"name": "9. GET Get Bookings by User ID (MongoDB)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Get bookings by user ID successful', function() {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
